<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Android blocks cleartext HTTP from API 28, which stops the
  debug app talking to a uvicorn on the dev machine's LAN address. This file
  lives under src/debug/, so it is never merged into a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
